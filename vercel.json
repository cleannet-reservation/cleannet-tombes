{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/upload-photo.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/send-rappel",
      "schedule": "0 16 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
